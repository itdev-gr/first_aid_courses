---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  images: ImageMetadata[];
  titleEl: string;
}
const { images, titleEl } = Astro.props;
const id = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---
<section aria-label={`Φωτογραφίες — ${titleEl}`} class="program-gallery">
  <div class="flex items-end justify-between gap-4">
    <h2 class="text-2xl font-semibold text-ink-strong">Στιγμιότυπα από την εκπαίδευση</h2>
    <div class="hidden sm:flex items-center gap-2">
      <button type="button" data-gallery-prev={id} aria-label="Προηγούμενη" class="w-10 h-10 rounded-full bg-white border border-hairline text-ink-edge hover:text-crimson hover:border-crimson transition-out flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" data-gallery-next={id} aria-label="Επόμενη" class="w-10 h-10 rounded-full bg-white border border-hairline text-ink-edge hover:text-crimson hover:border-crimson transition-out flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

  <div
    id={id}
    class="mt-6 flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 pb-4 [-webkit-overflow-scrolling:touch] [scrollbar-width:thin]"
  >
    {images.map((img, i) => (
      <figure class="snap-center shrink-0 w-[88%] sm:w-[70%] md:w-[55%] lg:w-[60%] xl:w-[50%]">
        <div class="aspect-[4/3] bg-surface-soft rounded-2xl overflow-hidden border border-hairline">
          <Image
            src={img}
            alt={`${titleEl} — εικόνα ${i + 1}`}
            widths={[480, 768, 1200]}
            sizes="(min-width: 1024px) 50vw, (min-width: 640px) 70vw, 90vw"
            class="h-full w-full object-cover"
          />
        </div>
      </figure>
    ))}
  </div>

  <ol class="mt-3 flex items-center justify-center gap-2" aria-label="Επιλογή εικόνας">
    {images.map((_, i) => (
      <li>
        <button
          type="button"
          data-gallery-dot={id}
          data-index={i}
          aria-label={`Πήγαινε στην εικόνα ${i + 1}`}
          class="w-2.5 h-2.5 rounded-full bg-ink-muted/30 hover:bg-crimson transition-out"
        ></button>
      </li>
    ))}
  </ol>
</section>

<script define:vars={{ id }}>
  const track = document.getElementById(id);
  if (track) {
    const prevBtn = document.querySelector(`[data-gallery-prev="${id}"]`);
    const nextBtn = document.querySelector(`[data-gallery-next="${id}"]`);
    const dots = Array.from(document.querySelectorAll(`[data-gallery-dot="${id}"]`));

    const slideWidth = () => {
      const first = track.firstElementChild;
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '0');
      return first.getBoundingClientRect().width + gap;
    };

    const updateDots = () => {
      const w = slideWidth();
      const idx = Math.round(track.scrollLeft / w);
      dots.forEach((d, i) => {
        d.classList.toggle('!bg-crimson', i === idx);
        d.classList.toggle('w-6', i === idx);
      });
      if (prevBtn) prevBtn.toggleAttribute('disabled', track.scrollLeft <= 4);
      if (nextBtn) nextBtn.toggleAttribute('disabled', track.scrollLeft + track.clientWidth >= track.scrollWidth - 4);
    };

    prevBtn?.addEventListener('click', () => track.scrollBy({ left: -slideWidth(), behavior: 'smooth' }));
    nextBtn?.addEventListener('click', () => track.scrollBy({ left: slideWidth(), behavior: 'smooth' }));
    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = Number(d.getAttribute('data-index') || 0);
        track.scrollTo({ left: i * slideWidth(), behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', () => requestAnimationFrame(updateDots), { passive: true });
    updateDots();
  }
</script>
