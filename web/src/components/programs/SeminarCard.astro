---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'programs'>; }
const { entry } = Astro.props;
const {
  code, titleEl, durationHours, evaluation, evaluationNote, priceEur, badgeImage, heroImage,
} = entry.data;

const logo = badgeImage ?? heroImage;
const detailsHref = `/seminaria/${entry.slug}/`;
---
<a
  href={detailsHref}
  class="group flex flex-col items-center text-center bg-white rounded-2xl border border-hairline p-6 md:p-8 shadow-tile h-full no-underline hover:shadow-tileHover hover:-translate-y-1 transition-out focus:outline-none focus-visible:ring-2 focus-visible:ring-crimson"
>
  <div class="w-32 h-32 md:w-36 md:h-36 rounded-full bg-white flex items-center justify-center overflow-hidden">
    <Image
      src={logo}
      alt={`Λογότυπο σεμιναρίου ${titleEl}`}
      width={144}
      height={144}
      densities={[1, 2]}
      quality={80}
      class="w-full h-full object-contain p-2"
    />
  </div>

  <h3 class="mt-5 font-display font-semibold text-ink-strong text-lg md:text-xl leading-tight group-hover:text-crimson transition-out">
    {titleEl}
  </h3>
  <p class="mt-1 text-ink-strong font-semibold">
    (κωδικός {code})
  </p>

  <p class="mt-5 text-ink-muted text-sm leading-relaxed">
    <span class="font-semibold text-ink-strong">Διάρκεια:</span> {durationHours} ώρες,
    <span class="font-semibold text-ink-strong">Αξιολόγηση:</span> {evaluation}
    {evaluationNote && (
      <span class="block mt-2 text-crimson font-semibold">({evaluationNote})</span>
    )}
  </p>

  <div class="mt-auto w-full flex flex-col items-center pt-6">
    {priceEur !== undefined && (
      <p class="font-display font-bold text-ink-strong text-2xl">
        €{priceEur} <span class="text-base font-normal">/ άτομο</span>
      </p>
    )}
    <span class="mt-6 inline-flex items-center justify-center text-center font-semibold transition-out text-base px-5 py-3.5 rounded-md bg-crimson text-white group-hover:bg-crimson-600 group-hover:shadow-cta">
      Περισσότερες Λεπτομέρειες
    </span>
  </div>
</a>
