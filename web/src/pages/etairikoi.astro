---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import Reveal from '../components/motion/Reveal.astro';
import ProgramCard from '../components/programs/ProgramCard.astro';

const programs = await getCollection('programs');
const business = programs.filter(p => p.data.audience === 'business').sort((a,b) => a.data.order - b.data.order);
const clients = (await getCollection('clients')).sort((a,b) => a.data.name.localeCompare(b.data.name));
---
<PageLayout
  title="Για Επιχειρήσεις"
  description="Ενδοεπιχειρησιακά σεμινάρια Πρώτων Βοηθειών για ομάδες κάθε μεγέθους. Νομική συμμόρφωση, πρακτικά σενάρια, πραγματική ασφάλεια.">

  <Section tone="default" pad="lg">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Για επιχειρήσεις</p>
        <h1 class="mt-3 font-display font-bold text-crimson text-4xl md:text-5xl leading-tight">Πρώτες Βοήθειες στον χώρο εργασίας</h1>
        <p class="mt-4 text-ink-muted text-lg leading-relaxed">
          Η εκπαίδευση πρώτου βοηθού είναι νομική απαίτηση και ταυτόχρονα ένα σημαντικό
          εργαλείο διατήρησης ασφαλούς εργασιακού περιβάλλοντος. Σχεδιάζουμε προγράμματα
          ευέλικτης διάρκειας, στον χώρο σας, με σενάρια προσαρμοσμένα στον κλάδο σας.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/kratisi/" variant="primary">Ζητήστε προσφορά</Button>
          <Button href="/epikoinonia/" variant="secondary">Μιλήστε μαζί μας</Button>
        </div>
      </div>
      <div class="lg:col-span-5">
        <ul class="grid grid-cols-2 gap-4">
          <li class="bg-surface-soft p-6 rounded-2xl"><p class="font-display font-bold text-3xl text-crimson">21+</p><p class="text-sm text-ink-muted mt-1">εταιρείες πελάτες</p></li>
          <li class="bg-surface-soft p-6 rounded-2xl"><p class="font-display font-bold text-3xl text-crimson">100%</p><p class="text-sm text-ink-muted mt-1">on-site εκπαίδευση</p></li>
          <li class="bg-surface-soft p-6 rounded-2xl"><p class="font-display font-bold text-3xl text-crimson">6-18h</p><p class="text-sm text-ink-muted mt-1">ευέλικτη διάρκεια</p></li>
          <li class="bg-surface-soft p-6 rounded-2xl"><p class="font-display font-bold text-3xl text-crimson">RTI</p><p class="text-sm text-ink-muted mt-1">διεθνής πιστοποίηση</p></li>
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="soft" pad="lg">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Νομικό πλαίσιο</p>
        <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Νέος Εργασιακός Νόμος</h2>
        <p class="mt-2 text-ink-muted font-semibold">Αρ. 5239/2025 (ΦΕΚ 178/Α/17-10-2025)</p>
      </div>
      <div class="lg:col-span-7 space-y-5 text-ink leading-relaxed">
        <p>
          Με τη δημοσίευση του Νόμου υπ' αριθμ. 5239/2025 (ΦΕΚ 178/Α/17-10-2025), θεσμοθετείται για πρώτη φορά η
          υποχρέωση των εργοδοτών να παρέχουν εκπαίδευση Καρδιοαναπνευστικής Αναζωογόνησης (ΚΑΡΠΑ) και
          αντιμετώπισης πνιγμονής (λαβής Χάιμλιχ) στο προσωπικό τους.
        </p>
        <blockquote class="border-l-4 border-crimson bg-white rounded-r-xl p-5 not-italic">
          <p class="font-semibold text-ink-strong">Άρθρο 39, περίπτωση δβ</p>
          <p class="mt-2 text-ink">
            Κάθε επιχείρηση που απασχολεί πάνω από 50 εργαζομένους οφείλει να παρέχει εκπαίδευση από
            πιστοποιημένους εκπαιδευτικούς φορείς πρώτων βοηθειών, καλύπτοντας τουλάχιστον το ήμισυ των
            εργαζομένων ανά τριετία.
          </p>
        </blockquote>
        <p>
          Το εκπαιδευτικό κέντρο <strong class="text-ink-strong">First Aid Academy</strong> σε συνεργασία με τη
          <strong class="text-ink-strong">Rescue Training International — First Aid Training</strong> μπορεί να
          αναλάβει την εκπαίδευση της εταιρείας σας, παρέχοντας υπηρεσίες υψηλής ποιότητας και πιστοποιήσεις
          με διεθνή αναγνώριση.
        </p>
        <p class="font-semibold text-ink-strong">
          Επικοινωνήστε μαζί μας και λάβετε τη δική σας μοναδική προσφορά για την επιχείρησή σας.
        </p>
        <div class="pt-2 flex flex-wrap gap-3">
          <Button href="/kratisi/?type=business" variant="primary">Λάβετε προσφορά</Button>
          <Button href="/epikoinonia/" variant="secondary">Επικοινωνήστε μαζί μας</Button>
        </div>
      </div>
    </div>

    <details class="mt-16 group border border-hairline rounded-2xl bg-white">
      <summary class="cursor-pointer list-none px-6 py-5 flex items-start justify-between gap-4 rounded-2xl hover:bg-surface-soft/40">
        <span class="flex flex-col">
          <span class="text-xs font-semibold uppercase tracking-wider text-cyan-700">Συμπληρωματικό νομικό κείμενο</span>
          <span class="mt-1 font-semibold text-ink-strong">Ελάχιστα απαιτούμενα υλικά πρώτων βοηθειών στους χώρους εργασίας</span>
          <span class="text-sm text-ink-muted mt-1">Αριθμ. οικ. 32205/Δ10.96 — ΦΕΚ Β' 2562/11-10-2013</span>
        </span>
        <svg class="shrink-0 mt-1 text-ink-muted transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>

      <div class="px-6 pb-8 pt-2 text-ink text-[15px] leading-relaxed space-y-4 border-t border-hairline">
        <p class="pt-4 font-semibold text-ink-strong uppercase tracking-wide text-sm">Ο Υφυπουργός Εργασίας, Κοινωνικής Ασφάλισης και Πρόνοιας</p>
        <p class="text-ink-muted">Έχοντας υπόψη:</p>
        <ol class="list-decimal pl-6 space-y-3 text-ink-muted">
          <li>Τις διατάξεις του άρθρου 45 παρ. 6 του «Κώδικα Νόμων για την Υγεία και την Ασφάλεια των Εργαζομένων» (Κ.Ν.Υ.Α.Ε.), που κυρώθηκε με το άρθρο πρώτο του ν. 3850/2010 (ΦΕΚ Α' 84), όπως συμπληρώθηκε με την προσθήκη του άρθρου 36 παρ. 4 του ν. 4144/2013 (ΦΕΚ Α' 88).</li>
          <li>Το γεγονός ότι από την απόφαση αυτή που αφορά τα ελάχιστα απαιτούμενα υλικά πρώτων βοηθειών στους χώρους εργασίας δεν προκαλείται δαπάνη σε βάρος του κρατικού προϋπολογισμού.</li>
          <li>Την υπ' αριθμ. 22365/97/5.7.2013 κοινή απόφαση Πρωθυπουργού και Υπουργού Εργασίας, Κοινωνικής Ασφάλισης και Πρόνοιας (ΦΕΚ Β' 1667).</li>
          <li>Την υπ' αριθμ. 7/10.9.2013 γνώμη του Συμβουλίου Υγείας και Ασφάλειας των Εργαζομένων (Σ.Υ.Α.Ε.).</li>
        </ol>
        <p class="font-semibold text-ink-strong">αποφασίζουμε:</p>

        <div class="pt-4 border-t border-hairline">
          <p class="font-semibold text-ink-strong uppercase tracking-wide text-sm">Άρθρο 1</p>
          <p class="mt-1 font-semibold text-ink-strong">Ελάχιστα απαιτούμενα υλικά πρώτων βοηθειών στους χώρους εργασίας</p>
          <p class="mt-3 text-ink-muted">Τα ελάχιστα απαιτούμενα υλικά των χώρων πρώτων βοηθειών και των φαρμακείων στους χώρους εργασίας είναι:</p>
          <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-2 text-ink-muted">
            <li><span class="font-semibold text-ink-strong">α)</span> Ακετυλοσαλικυλικό οξύ.</li>
            <li><span class="font-semibold text-ink-strong">β)</span> Παρακεταμόλη.</li>
            <li><span class="font-semibold text-ink-strong">γ)</span> Αντιισταμινικά δισκία.</li>
            <li><span class="font-semibold text-ink-strong">δ)</span> Δισκία κορτιζόνης (πρεδνιζολόνη 4 mg).</li>
            <li><span class="font-semibold text-ink-strong">ε)</span> Ενέσιμο σκεύασμα κορτιζόνης (μεθυλπρεδνιζολόνη 125 mg).</li>
            <li><span class="font-semibold text-ink-strong">στ)</span> Αντιόξινα δισκία.</li>
            <li><span class="font-semibold text-ink-strong">ζ)</span> Σπασμολυτικά δισκία.</li>
            <li><span class="font-semibold text-ink-strong">η)</span> Αντιδιαρροϊκά δισκία — Loperamide.</li>
            <li><span class="font-semibold text-ink-strong">θ)</span> Οφθαλμικό διάλυμα για πλύση.</li>
            <li><span class="font-semibold text-ink-strong">ι)</span> Αντισηπτικό κολλύριο.</li>
            <li><span class="font-semibold text-ink-strong">ια)</span> Αντιϊσταμινική αλοιφή.</li>
            <li><span class="font-semibold text-ink-strong">ιβ)</span> Αλοιφή για επούλωση εγκαυμάτων.</li>
            <li><span class="font-semibold text-ink-strong">ιγ)</span> Γάντια.</li>
            <li><span class="font-semibold text-ink-strong">ιδ)</span> Υγρό απολύμανσης χεριών.</li>
            <li><span class="font-semibold text-ink-strong">ιε)</span> Αποστειρωμένες γάζες — κουτιά πέντε, δέκα και δεκαπέντε εκατοστών.</li>
            <li><span class="font-semibold text-ink-strong">ιστ)</span> Γάζες εμποτισμένες με αντιβιοτικό (Fusidic acid).</li>
            <li><span class="font-semibold text-ink-strong">ιζ)</span> Βαμβάκι.</li>
            <li><span class="font-semibold text-ink-strong">ιη)</span> Λευκοπλάστης πλάτους 0,08 μέτρα.</li>
            <li><span class="font-semibold text-ink-strong">ιθ)</span> Τεμάχια λευκοπλάστη με γάζα αποστειρωμένη.</li>
            <li><span class="font-semibold text-ink-strong">κ)</span> Επίδεσμος 2,50 × 0,05 μέτρα.</li>
            <li><span class="font-semibold text-ink-strong">κα)</span> Επίδεσμος 2,50 × 0,10 μέτρα.</li>
            <li><span class="font-semibold text-ink-strong">κβ)</span> Τριγωνικός επίδεσμος.</li>
            <li><span class="font-semibold text-ink-strong">κγ)</span> Αιμοστατικός επίδεσμος.</li>
            <li><span class="font-semibold text-ink-strong">κδ)</span> Φυσιολογικός ορός 250 ή 500 ml.</li>
            <li><span class="font-semibold text-ink-strong">κε)</span> Οξυζενέ.</li>
            <li><span class="font-semibold text-ink-strong">κστ)</span> Οινόπνευμα καθαρό.</li>
            <li><span class="font-semibold text-ink-strong">κζ)</span> Αντισηπτικό διάλυμα (Povidone Iodine 10 %).</li>
            <li><span class="font-semibold text-ink-strong">κη)</span> Γλωσσοπίεστρα.</li>
            <li><span class="font-semibold text-ink-strong">κθ)</span> Ποτηράκια μιας χρήσης (χάρτινα ή πλαστικά).</li>
          </ul>
        </div>
      </div>
    </details>
  </Section>

  <Section tone="cyan" pad="lg">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Τα προγράμματά μας</p>
      <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Διαλέξτε το επίπεδο που ταιριάζει στην ομάδα σας</h2>
    </div>
    <Reveal stagger={0.1}>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {business.map((p) => <li><ProgramCard entry={p} /></li>)}
      </ul>
    </Reveal>
  </Section>

  <Section tone="default" pad="lg">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Πώς δουλεύουμε</p>
      <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Από το πρώτο τηλέφωνο μέχρι την πιστοποίηση</h2>
    </div>
    <Reveal stagger={0.08}>
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {[
          { n: '01', t: 'Επικοινωνία',    d: 'Καταγραφή των αναγκών της επιχείρησης, του αριθμού συμμετεχόντων και του κλάδου.' },
          { n: '02', t: 'Σχεδιασμός',     d: 'Πρόταση προγράμματος (FAW ή EFAW) με προσαρμοσμένα σενάρια.' },
          { n: '03', t: 'Εκπαίδευση',     d: 'Διεξαγωγή στον χώρο σας με όλο τον απαραίτητο εξοπλισμό.' },
          { n: '04', t: 'Πιστοποίηση',    d: 'Αξιολόγηση και έκδοση πιστοποιητικών συμμετοχής.' },
        ].map((s) => (
          <li class="border-t-2 border-crimson pt-4">
            <p class="font-display font-bold text-crimson/40 text-3xl">{s.n}</p>
            <p class="mt-2 font-semibold text-ink-strong text-lg">{s.t}</p>
            <p class="mt-2 text-ink-muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </Reveal>
  </Section>

  <Section tone="soft" pad="md">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Μας εμπιστεύονται</p>
      <h2 class="mt-3 text-crimson font-display font-semibold text-2xl md:text-3xl">Πελάτες που έχουν εκπαιδεύσει τις ομάδες τους μαζί μας</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-8 gap-y-10 items-center">
      {clients.map((c) => (
        <li class="flex justify-center" title={c.data.name}>
          <Image src={c.data.logo} alt={c.data.name} widths={[120, 200]} sizes="120px" class="max-h-14 w-auto object-contain" />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="crimson" pad="md">
    <div class="text-center">
      <h2 class="font-display font-bold uppercase text-white text-3xl md:text-4xl">Έτοιμοι να ξεκινήσουμε;</h2>
      <p class="mt-4 text-white/90 text-lg max-w-2xl mx-auto">Στείλτε μας τις ανάγκες σας — θα σας απαντήσουμε με πρόταση εντός 24 ωρών.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/kratisi/?type=business" variant="primary" className="bg-white !text-crimson hover:bg-white/90">Ζητήστε προσφορά</Button>
        <Button href="/epikoinonia/" variant="secondary" className="bg-white/10 border-white/40 text-white hover:bg-white/20 ring-0">Επικοινωνία</Button>
      </div>
    </div>
  </Section>
</PageLayout>
