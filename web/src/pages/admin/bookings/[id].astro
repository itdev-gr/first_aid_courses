---
import { getEntry } from 'astro:content';
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getBooking, type BookingStatus } from '../../../lib/firebase/bookings';
import { getSession, formatAthensDisplay } from '../../../lib/firebase/sessions';

const id = Astro.params.id!;
const booking = await getBooking(id);
if (!booking) {
  return Astro.redirect('/admin/bookings/?missing=1', 302);
}
const session = await getSession(booking.sessionId);
const program = await getEntry('programs', booking.programSlug);

const statusLabel: Record<BookingStatus, string> = {
  pending:   'Εκκρεμεί',
  confirmed: 'Επιβεβαιωμένη',
  paid:      'Πληρωμένη',
  cancelled: 'Ακυρωμένη',
  expired:   'Έληξε',
};
---
<AdminLayout title="Κράτηση">
  <div class="mb-6">
    <a href="/admin/bookings/" class="text-sm text-cyan-700 hover:text-crimson font-semibold no-underline">← Επιστροφή</a>
    <h1 class="mt-2 font-display font-bold text-crimson text-3xl">{booking.contact.name}</h1>
    <p class="mt-1 text-xs text-ink-muted">Booking ID: <code>{booking.id}</code></p>
  </div>

  <div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl border border-hairline shadow-tile p-6">
        <h2 class="text-sm uppercase tracking-wider font-semibold text-cyan-700">Στοιχεία πελάτη</h2>
        <dl class="mt-4 grid sm:grid-cols-2 gap-4 text-sm">
          <div><dt class="text-ink-muted">Ονοματεπώνυμο</dt><dd class="mt-0.5 font-semibold text-ink-strong">{booking.contact.name}</dd></div>
          <div><dt class="text-ink-muted">Τύπος</dt><dd class="mt-0.5 font-semibold text-ink-strong">{booking.type === 'individual' ? 'Ιδιώτης / Γονέας' : 'Επιχείρηση'}</dd></div>
          <div><dt class="text-ink-muted">Email</dt><dd class="mt-0.5"><a href={`mailto:${booking.contact.email}`} class="font-semibold text-cyan-700 hover:text-crimson">{booking.contact.email}</a></dd></div>
          <div><dt class="text-ink-muted">Τηλέφωνο</dt><dd class="mt-0.5"><a href={`tel:${booking.contact.phone}`} class="font-semibold text-cyan-700 hover:text-crimson">{booking.contact.phone}</a></dd></div>
          {booking.contact.company && (
            <div class="sm:col-span-2"><dt class="text-ink-muted">Επιχείρηση</dt><dd class="mt-0.5 font-semibold text-ink-strong">{booking.contact.company}</dd></div>
          )}
        </dl>
      </div>

      <div class="bg-white rounded-2xl border border-hairline shadow-tile p-6">
        <h2 class="text-sm uppercase tracking-wider font-semibold text-cyan-700">Σεμινάριο</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Πρόγραμμα</dt><dd class="font-semibold text-ink-strong text-right">{program?.data.titleEl ?? booking.programSlug} <span class="text-ink-muted font-normal">({program?.data.code ?? ''})</span></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Ημερομηνία</dt><dd class="font-semibold text-ink-strong text-right">{session ? formatAthensDisplay(session.startsAt) : '—'}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Τοποθεσία</dt><dd class="font-semibold text-ink-strong text-right">{session?.location ?? '—'}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Συμμετέχοντες</dt><dd class="font-semibold text-ink-strong text-right">{booking.participantCount}</dd></div>
          <div class="flex justify-between gap-4 pt-3 border-t border-hairline"><dt class="text-ink-muted">Σύνολο</dt><dd class="font-display font-bold text-crimson text-2xl">€{booking.totalEur}</dd></div>
        </dl>
        {session && (
          <p class="mt-4 text-sm"><a href={`/admin/sessions/${session.id}`} class="text-cyan-700 hover:text-crimson font-semibold no-underline">→ Άνοιγμα ημερομηνίας στον πίνακα</a></p>
        )}
      </div>

      {booking.message && (
        <div class="bg-white rounded-2xl border border-hairline shadow-tile p-6">
          <h2 class="text-sm uppercase tracking-wider font-semibold text-cyan-700">Σχόλια / ερωτήσεις</h2>
          <p class="mt-3 text-ink leading-relaxed whitespace-pre-line">{booking.message}</p>
        </div>
      )}
    </div>

    <aside class="lg:col-span-1 space-y-6">
      <div class="bg-white rounded-2xl border border-hairline shadow-tile p-6">
        <h2 class="text-sm uppercase tracking-wider font-semibold text-cyan-700">Κατάσταση</h2>
        <p class="mt-3 text-2xl font-display font-bold text-ink-strong">{statusLabel[booking.status]}</p>

        <label class="block mt-5 text-xs font-semibold uppercase tracking-wider text-cyan-700">Αλλαγή σε</label>
        <select id="status-select" class="mt-1 w-full rounded-md border border-hairline bg-white px-3 py-2 text-sm">
          {(['pending','confirmed','paid','cancelled','expired'] as BookingStatus[]).map((s) => (
            <option value={s} selected={s === booking.status}>{statusLabel[s]}</option>
          ))}
        </select>
        <button id="status-save" type="button" data-id={booking.id} class="mt-3 w-full bg-crimson text-white font-semibold py-2 rounded-md text-sm hover:bg-crimson-600 transition-out">Αποθήκευση κατάστασης</button>
        <p id="status-msg" class="mt-2 text-xs text-emerald-700 hidden">Αποθηκεύτηκε.</p>
      </div>

      <div class="bg-white rounded-2xl border border-hairline shadow-tile p-6">
        <h2 class="text-sm uppercase tracking-wider font-semibold text-cyan-700">Πληροφορίες</h2>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Καταχώρηση</dt><dd class="text-ink-strong text-right text-xs">{formatAthensDisplay(booking.createdAt)}</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Λήξη pending</dt><dd class="text-ink-strong text-right text-xs">{formatAthensDisplay(booking.expiresAt)}</dd></div>
          {booking.paymentRef && (
            <div class="flex justify-between gap-4"><dt class="text-ink-muted">Payment ref</dt><dd class="text-ink-strong text-right text-xs break-all">{booking.paymentRef}</dd></div>
          )}
        </dl>
      </div>

      <button id="delete-btn" type="button" data-id={booking.id} class="w-full text-red-600 hover:text-red-800 font-semibold text-sm py-2">Διαγραφή κράτησης</button>
    </aside>
  </div>

  <script>
    const id = (document.getElementById('status-save') as HTMLButtonElement).dataset.id!;
    const sel = document.getElementById('status-select') as HTMLSelectElement;
    const msg = document.getElementById('status-msg') as HTMLElement;

    document.getElementById('status-save')?.addEventListener('click', async () => {
      msg.classList.add('hidden');
      const res = await fetch(`/api/admin/bookings/${id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ status: sel.value }),
      });
      if (res.ok) {
        msg.textContent = 'Αποθηκεύτηκε.';
        msg.classList.remove('hidden', 'text-red-600');
        msg.classList.add('text-emerald-700');
        setTimeout(() => window.location.reload(), 600);
      } else {
        msg.textContent = 'Σφάλμα κατά την αποθήκευση.';
        msg.classList.remove('hidden', 'text-emerald-700');
        msg.classList.add('text-red-600');
      }
    });

    document.getElementById('delete-btn')?.addEventListener('click', async () => {
      if (!confirm('Διαγραφή αυτής της κράτησης; Η ενέργεια δεν μπορεί να αναιρεθεί.')) return;
      const res = await fetch(`/api/admin/bookings/${id}`, { method: 'DELETE' });
      if (res.ok) window.location.href = '/admin/bookings/';
      else alert('Σφάλμα κατά τη διαγραφή.');
    });
  </script>
</AdminLayout>
