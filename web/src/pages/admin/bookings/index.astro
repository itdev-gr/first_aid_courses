---
import { getCollection } from 'astro:content';
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { listBookings, type BookingStatus } from '../../../lib/firebase/bookings';
import { listSessions, formatAthensDisplay } from '../../../lib/firebase/sessions';

const url = new URL(Astro.request.url);
const filterStatus = url.searchParams.get('status') ?? '';
const filterProgram = url.searchParams.get('program') ?? '';

const [bookingsAll, sessionsAll, programs] = await Promise.all([
  listBookings(),
  listSessions(),
  getCollection('programs'),
]);

const sessionById = new Map(sessionsAll.map((s) => [s.id, s] as const));
const programBySlug = new Map(programs.map((p) => [p.slug, p.data] as const));

let bookings = bookingsAll;
if (filterStatus) bookings = bookings.filter((b) => b.status === filterStatus);
if (filterProgram) bookings = bookings.filter((b) => b.programSlug === filterProgram);

const statusLabel: Record<BookingStatus, string> = {
  pending:   'Εκκρεμεί',
  confirmed: 'Επιβεβαιωμένη',
  paid:      'Πληρωμένη',
  cancelled: 'Ακυρωμένη',
  expired:   'Έληξε',
};
const statusColor: Record<BookingStatus, string> = {
  pending:   'bg-amber-50 text-amber-800 border border-amber-200',
  confirmed: 'bg-cyan-50 text-cyan-800 border border-cyan-200',
  paid:      'bg-emerald-50 text-emerald-800 border border-emerald-200',
  cancelled: 'bg-red-50 text-red-700 border border-red-200',
  expired:   'bg-slate-100 text-slate-700 border border-slate-200',
};

// Quick stats
const counts = {
  all: bookingsAll.length,
  pending: bookingsAll.filter((b) => b.status === 'pending').length,
  paid: bookingsAll.filter((b) => b.status === 'paid').length,
  totalRevenueEur: bookingsAll.filter((b) => b.status === 'paid').reduce((sum, b) => sum + b.totalEur, 0),
};
---
<AdminLayout title="Κρατήσεις">
  <h1 class="font-display font-bold text-crimson text-3xl">Κρατήσεις</h1>
  <p class="mt-2 text-ink-muted">Όλες οι αιτήσεις κράτησης από τη φόρμα του ιστότοπου.</p>

  <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Σύνολο</p>
      <p class="mt-1 font-display font-bold text-ink-strong text-2xl">{counts.all}</p>
    </div>
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Εκκρεμείς</p>
      <p class="mt-1 font-display font-bold text-amber-700 text-2xl">{counts.pending}</p>
    </div>
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Πληρωμένες</p>
      <p class="mt-1 font-display font-bold text-emerald-700 text-2xl">{counts.paid}</p>
    </div>
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Έσοδα (πληρωμένα)</p>
      <p class="mt-1 font-display font-bold text-crimson text-2xl">€{counts.totalRevenueEur}</p>
    </div>
  </div>

  <form method="get" action="/admin/bookings/" class="mt-6 bg-white border border-hairline rounded-2xl p-4 shadow-tile flex flex-wrap items-end gap-3">
    <div class="flex-1 min-w-[140px]">
      <label class="block text-xs font-semibold uppercase tracking-wider text-cyan-700">Κατάσταση</label>
      <select name="status" class="mt-1 w-full rounded-md border border-hairline bg-white px-3 py-2 text-sm">
        <option value="">Όλες</option>
        {(['pending','confirmed','paid','cancelled','expired'] as BookingStatus[]).map((s) => (
          <option value={s} selected={s === filterStatus}>{statusLabel[s]}</option>
        ))}
      </select>
    </div>
    <div class="flex-1 min-w-[180px]">
      <label class="block text-xs font-semibold uppercase tracking-wider text-cyan-700">Σεμινάριο</label>
      <select name="program" class="mt-1 w-full rounded-md border border-hairline bg-white px-3 py-2 text-sm">
        <option value="">Όλα</option>
        {programs.map((p) => (
          <option value={p.slug} selected={p.slug === filterProgram}>{p.data.titleEl}</option>
        ))}
      </select>
    </div>
    <button type="submit" class="bg-crimson text-white font-semibold px-4 py-2 rounded-md text-sm">Φιλτράρισμα</button>
    {(filterStatus || filterProgram) && (
      <a href="/admin/bookings/" class="text-sm font-semibold text-ink-edge hover:text-crimson no-underline">Καθαρισμός</a>
    )}
  </form>

  <div class="mt-6 bg-white rounded-2xl border border-hairline shadow-tile overflow-hidden">
    {bookings.length === 0 ? (
      <p class="text-center text-ink-muted py-12">Δεν υπάρχουν κρατήσεις {filterStatus || filterProgram ? 'για το επιλεγμένο φίλτρο' : 'ακόμη'}.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-surface-cyan text-ink-strong text-left">
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Πελάτης</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Σεμινάριο</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Ημερομηνία</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Άτομα</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Σύνολο</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Κατάσταση</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Καταχώρηση</th>
            </tr>
          </thead>
          <tbody>
            {bookings.map((b) => {
              const session = sessionById.get(b.sessionId);
              const prog = programBySlug.get(b.programSlug);
              return (
                <tr class="border-t border-hairline hover:bg-surface-soft/50">
                  <td class="px-5 py-4">
                    <a href={`/admin/bookings/${b.id}`} class="block no-underline">
                      <p class="font-semibold text-ink-strong hover:text-crimson">{b.contact.name}</p>
                      <p class="text-xs text-ink-muted">{b.contact.email}</p>
                    </a>
                  </td>
                  <td class="px-5 py-4 text-ink">{prog?.titleEl ?? b.programSlug}</td>
                  <td class="px-5 py-4 text-ink whitespace-nowrap">{session ? formatAthensDisplay(session.startsAt) : '—'}</td>
                  <td class="px-5 py-4 text-ink-muted">{b.participantCount}</td>
                  <td class="px-5 py-4 font-display font-bold text-crimson">€{b.totalEur}</td>
                  <td class="px-5 py-4">
                    <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${statusColor[b.status]}`}>{statusLabel[b.status]}</span>
                  </td>
                  <td class="px-5 py-4 text-ink-muted text-sm whitespace-nowrap">{formatAthensDisplay(b.createdAt)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
