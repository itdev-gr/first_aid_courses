---
import { getCollection } from 'astro:content';
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { listBookings } from '../../../lib/firebase/bookings';
import { listSessions, formatAthensDisplay } from '../../../lib/firebase/sessions';
import { getMode } from '../../../lib/viva';

const [bookingsAll, sessionsAll, programs] = await Promise.all([
  listBookings(),
  listSessions(),
  getCollection('programs'),
]);

const sessionById = new Map(sessionsAll.map((s) => [s.id, s] as const));
const programBySlug = new Map(programs.map((p) => [p.slug, p.data] as const));

const paid = bookingsAll.filter((b) => b.status === 'paid');
const totalPaidEur = paid.reduce((sum, b) => sum + b.totalEur, 0);
const last30Days = paid.filter((b) => Date.now() - b.createdAt.getTime() < 30 * 24 * 60 * 60 * 1000);
const last30DaysEur = last30Days.reduce((sum, b) => sum + b.totalEur, 0);

const mode = getMode();
---
<AdminLayout title="Πληρωμές">
  <h1 class="font-display font-bold text-crimson text-3xl">Πληρωμές</h1>
  <p class="mt-2 text-ink-muted">Ολοκληρωμένες πληρωμές μέσω Viva Wallet (ή mock σε mode ανάπτυξης).</p>

  <div class="mt-3 inline-flex items-center gap-2 text-xs">
    <span class="font-semibold uppercase tracking-wider text-cyan-700">Πύλη πληρωμής:</span>
    <span class={`px-2 py-0.5 rounded font-semibold ${mode === 'production' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : mode === 'demo' ? 'bg-cyan-50 text-cyan-700 border border-cyan-200' : 'bg-amber-50 text-amber-800 border border-amber-200'}`}>
      {mode === 'production' ? 'Παραγωγή' : mode === 'demo' ? 'Demo (Viva)' : 'Mock (development)'}
    </span>
  </div>

  <div class="mt-6 grid grid-cols-2 md:grid-cols-3 gap-4">
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Πληρωμές συνολικά</p>
      <p class="mt-1 font-display font-bold text-ink-strong text-2xl">{paid.length}</p>
    </div>
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Έσοδα συνολικά</p>
      <p class="mt-1 font-display font-bold text-emerald-700 text-2xl">€{totalPaidEur}</p>
    </div>
    <div class="bg-white border border-hairline rounded-2xl p-4 shadow-tile">
      <p class="text-xs uppercase tracking-wider text-cyan-700 font-semibold">Έσοδα 30 ημερών</p>
      <p class="mt-1 font-display font-bold text-emerald-700 text-2xl">€{last30DaysEur}</p>
    </div>
  </div>

  <div class="mt-6 bg-white rounded-2xl border border-hairline shadow-tile overflow-hidden">
    {paid.length === 0 ? (
      <p class="text-center text-ink-muted py-12">Δεν υπάρχουν πληρωμές ακόμη.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-surface-cyan text-ink-strong text-left">
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Πελάτης</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Σεμινάριο</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Ημερομηνία σεμιναρίου</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Άτομα</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Ποσό</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Payment ref</th>
              <th class="text-xs uppercase tracking-wider font-semibold px-5 py-3">Καταχώρηση</th>
            </tr>
          </thead>
          <tbody>
            {paid.map((b) => {
              const session = sessionById.get(b.sessionId);
              const prog = programBySlug.get(b.programSlug);
              return (
                <tr class="border-t border-hairline hover:bg-surface-soft/50">
                  <td class="px-5 py-4">
                    <a href={`/admin/bookings/${b.id}`} class="block no-underline">
                      <p class="font-semibold text-ink-strong hover:text-crimson">{b.contact.name}</p>
                      <p class="text-xs text-ink-muted">{b.contact.email}</p>
                    </a>
                  </td>
                  <td class="px-5 py-4 text-ink">{prog?.titleEl ?? b.programSlug}</td>
                  <td class="px-5 py-4 text-ink whitespace-nowrap">{session ? formatAthensDisplay(session.startsAt) : '—'}</td>
                  <td class="px-5 py-4 text-ink-muted">{b.participantCount}</td>
                  <td class="px-5 py-4 font-display font-bold text-emerald-700">€{b.totalEur}</td>
                  <td class="px-5 py-4 text-ink-muted text-xs font-mono break-all max-w-[140px]">{b.paymentRef ?? '—'}</td>
                  <td class="px-5 py-4 text-ink-muted text-sm whitespace-nowrap">{formatAthensDisplay(b.createdAt)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
