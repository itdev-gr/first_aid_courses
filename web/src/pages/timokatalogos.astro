---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';

const all = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
const individual = all.filter(p => p.data.priceEur !== undefined && p.data.audience !== 'business');

const businessRows: { label: string; priceEur: number; note?: string }[] = [
  { label: 'Επείγουσα Πρώτη Βοήθεια στην Εργασία', priceEur: 60, note: 'GR' },
  { label: 'Επείγουσα Πρώτη Βοήθεια στην Εργασία +', priceEur: 75, note: 'GR' },
  { label: 'Πρώτες Βοήθειες στην Εργασία', priceEur: 300, note: 'CY' },
  { label: 'Επείγουσα Πρώτη Βοήθεια στην Εργασία', priceEur: 150, note: 'CY' },
  { label: 'Πρώτες Βοήθειες στην Εργασία', priceEur: 300, note: 'UK' },
  { label: 'Επείγουσα Πρώτη Βοήθεια στην Εργασία', priceEur: 160, note: 'UK' },
  { label: 'Πρώτες Βοήθειες στην Εργασία', priceEur: 200, note: 'ανανέωση πιστοποίησης' },
  { label: 'Επείγοντα Περιστατικά', priceEur: 110, note: 'ανανέωση πιστοποίησης' },
];
---
<PageLayout
  title="Τιμοκατάλογος Προγραμμάτων Εκπαίδευσης Πρώτων Βοηθειών"
  description="Τιμοκατάλογος σεμιναρίων Πρώτων Βοηθειών First Aid Academy — τιμές για ιδιώτες και ειδικές τιμές για επιχειρήσεις και οργανωμένες ομάδες.">

  <Section tone="default" pad="lg">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Τιμοκατάλογος</p>
      <h1 class="mt-3 font-display font-bold text-crimson text-4xl md:text-5xl leading-tight">
        Τιμοκατάλογος Προγραμμάτων Εκπαίδευσης Πρώτων Βοηθειών
      </h1>
      <div class="mt-6 space-y-4 text-ink-muted text-lg leading-relaxed">
        <p>
          Οι τιμές των προγραμμάτων είναι κατ' άτομο και αφορούν την εκπαίδευση σε μορφή σεμιναρίων σε φυσικό χώρο
          και χρονική περίοδο προγραμματισμένη απο το κέντρο μας.
        </p>
        <p>
          Ειδικές τιμές για εταιρείες και οργανωμένες ομάδες καθως είτε στον χώρο μας είτε στον δικό σας μετά απο
          συνεννόηση με το κέντρο μας.
        </p>
        <p>
          Στις τιμές των εκπαιδευτικών μας προγραμμάτων περιλαμβάνεται πλήρες εκπαιδευτικό υλικό καθώς και τα έξοδα
          της έκδοσης των πιστοποιητικών των εκπαιδευομένων.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="soft" pad="lg">
    <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Ιδιώτες</p>
    <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Σεμινάρια για ιδιώτες</h2>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full bg-white rounded-2xl border border-hairline shadow-tile overflow-hidden">
        <thead>
          <tr class="bg-surface-cyan text-ink-strong">
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Σεμινάριο</th>
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Κωδικός</th>
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Διάρκεια</th>
            <th class="text-right text-sm uppercase tracking-wider font-semibold px-6 py-4">Τιμή / άτομο</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>
        <tbody>
          {individual.map((p) => (
            <tr class="border-t border-hairline">
              <td class="px-6 py-5 font-semibold text-ink-strong">{p.data.titleEl}</td>
              <td class="px-6 py-5 text-ink-muted">{p.data.code}</td>
              <td class="px-6 py-5 text-ink-muted">{p.data.durationHours} ώρες</td>
              <td class="px-6 py-5 text-right font-display font-bold text-crimson text-xl">€{p.data.priceEur}</td>
              <td class="px-6 py-5 text-right">
                <Button href={`/kratisi/?program=${p.slug}`} variant="primary" size="sm">Επιλογή Ημερομηνίας</Button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section tone="cyan" pad="lg">
    <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Επιχειρήσεις & εταιρίες</p>
    <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Ενδοεπιχειρησιακά προγράμματα</h2>
    <p class="mt-4 text-ink-muted leading-relaxed max-w-2xl">
      Οι παρακάτω τιμές αφορούν ενδοεπιχειρησιακές εκπαιδεύσεις στον χώρο μας ή στις εγκαταστάσεις σας, μετά απο
      συνεννόηση. Επικοινωνήστε μαζί μας για ακριβή προσφορά με βάση τον αριθμό συμμετεχόντων και την περιοχή.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full bg-white rounded-2xl border border-hairline shadow-tile overflow-hidden">
        <thead>
          <tr class="bg-surface-cyan text-ink-strong">
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Πρόγραμμα</th>
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Παραλλαγή</th>
            <th class="text-right text-sm uppercase tracking-wider font-semibold px-6 py-4">Τιμή / άτομο</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>
        <tbody>
          {businessRows.map((row) => (
            <tr class="border-t border-hairline">
              <td class="px-6 py-5 font-semibold text-ink-strong">{row.label}</td>
              <td class="px-6 py-5 text-ink-muted">{row.note}</td>
              <td class="px-6 py-5 text-right font-display font-bold text-crimson text-xl">€{row.priceEur}</td>
              <td class="px-6 py-5 text-right">
                <Button href="/epicheiriseis/#contact" variant="secondary" size="sm">Ζητήστε προσφορά</Button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>
</PageLayout>
