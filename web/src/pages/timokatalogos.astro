---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';

const all = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
const priced = all.filter(p => p.data.priceEur !== undefined);
const business = all.filter(p => p.data.audience === 'business');
---
<PageLayout
  title="Τιμοκατάλογος"
  description="Τιμοκατάλογος σεμιναρίων Πρώτων Βοηθειών First Aid Academy — όλες οι τιμές ανά πρόγραμμα και κωδικό.">

  <Section tone="default" pad="lg">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Τιμοκατάλογος</p>
      <h1 class="mt-3 font-display font-bold text-crimson text-4xl md:text-5xl leading-tight">Τιμές σεμιναρίων</h1>
      <p class="mt-4 text-ink-muted text-lg leading-relaxed">
        Όλες οι τιμές αφορούν ατομική συμμετοχή και περιλαμβάνουν εκπαιδευτικό υλικό, αξιολόγηση και πιστοποιητικό συμμετοχής.
      </p>
    </div>
  </Section>

  <Section tone="soft" pad="lg">
    <div class="overflow-x-auto">
      <table class="w-full bg-white rounded-2xl border border-hairline shadow-tile overflow-hidden">
        <thead>
          <tr class="bg-surface-cyan text-ink-strong">
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Σεμινάριο</th>
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Κωδικός</th>
            <th class="text-left text-sm uppercase tracking-wider font-semibold px-6 py-4">Διάρκεια</th>
            <th class="text-right text-sm uppercase tracking-wider font-semibold px-6 py-4">Τιμή / άτομο</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>
        <tbody>
          {priced.map((p) => (
            <tr class="border-t border-hairline">
              <td class="px-6 py-5 font-semibold text-ink-strong">{p.data.titleEl}</td>
              <td class="px-6 py-5 text-ink-muted">{p.data.code}</td>
              <td class="px-6 py-5 text-ink-muted">{p.data.durationHours} ώρες</td>
              <td class="px-6 py-5 text-right font-display font-bold text-crimson text-xl">€{p.data.priceEur}</td>
              <td class="px-6 py-5 text-right">
                <Button href={`/kratisi/?program=${p.slug}`} variant="primary" size="sm">Επιλογή Ημερομηνίας</Button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  {business.length > 0 && (
    <Section tone="cyan" pad="lg">
      <p class="text-sm font-semibold uppercase tracking-wider text-cyan-700">Για επιχειρήσεις</p>
      <h2 class="mt-3 text-crimson font-display font-semibold text-3xl md:text-4xl">Ενδοεπιχειρησιακά προγράμματα</h2>
      <p class="mt-4 text-ink-muted leading-relaxed max-w-2xl">
        Οι ενδοεπιχειρησιακές εκπαιδεύσεις τιμολογούνται κατόπιν συνεννόησης με βάση τον αριθμό συμμετεχόντων, τη διάρκεια και τη
        γεωγραφική περιοχή. Επικοινωνήστε μαζί μας για προσφορά.
      </p>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {business.map((p) => (
          <li class="bg-white border border-hairline rounded-xl p-5 flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold text-ink-strong">{p.data.titleEl}</p>
              <p class="text-sm text-ink-muted mt-1">{p.data.code} · {p.data.durationHours} ώρες</p>
            </div>
            <Button href={`/kratisi/?program=${p.slug}&type=business`} variant="secondary" size="sm">Ζητήστε προσφορά</Button>
          </li>
        ))}
      </ul>
    </Section>
  )}
</PageLayout>
