---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import { phone } from '../../lib/nav';
import { getBooking } from '../../lib/firebase/bookings';
import { getSession, formatAthensDisplay } from '../../lib/firebase/sessions';
import { getCollection } from 'astro:content';

const url = new URL(Astro.request.url);
const id = url.searchParams.get('id');
const booking = id ? await getBooking(id) : null;
const session = booking ? await getSession(booking.sessionId) : null;

const programs = await getCollection('programs');
const programTitle = booking
  ? programs.find((p) => p.slug === booking.programSlug)?.data.titleEl ?? booking.programSlug
  : '';

const minutesUntilExpiry = booking
  ? Math.max(0, Math.floor((booking.expiresAt.getTime() - Date.now()) / 60000))
  : 0;
---
<PageLayout title="Λάβαμε το αίτημά σας" description="Η κράτησή σας καταχωρήθηκε. Ολοκληρώστε την πληρωμή για να επιβεβαιωθεί η θέση σας." noindex>
  <Section tone="default" pad="lg">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mx-auto h-16 w-16 rounded-full bg-surface-crimson flex items-center justify-center text-crimson">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 class="mt-6 font-display font-bold text-crimson text-3xl md:text-4xl">Η κράτησή σας καταχωρήθηκε</h1>

      {booking ? (
        <>
          <p class="mt-4 text-ink-muted text-lg leading-relaxed">
            Η θέση σας θα δεσμευτεί <strong class="text-ink-strong">μόλις ολοκληρωθεί η πληρωμή</strong>.
            Έχετε <strong class="text-ink-strong">{minutesUntilExpiry} λεπτά</strong> για να ολοκληρώσετε τη συναλλαγή.
          </p>

          <div class="mt-8 bg-surface-soft rounded-2xl border border-hairline p-6 text-left space-y-3">
            <div class="flex justify-between gap-4">
              <span class="text-sm text-ink-muted">Σεμινάριο</span>
              <span class="text-sm font-semibold text-ink-strong">{programTitle}</span>
            </div>
            <div class="flex justify-between gap-4">
              <span class="text-sm text-ink-muted">Ημερομηνία</span>
              <span class="text-sm font-semibold text-ink-strong">{session ? formatAthensDisplay(session.startsAt) : '—'}</span>
            </div>
            {session?.location && (
              <div class="flex justify-between gap-4">
                <span class="text-sm text-ink-muted">Τοποθεσία</span>
                <span class="text-sm font-semibold text-ink-strong">{session.location}</span>
              </div>
            )}
            <div class="flex justify-between gap-4">
              <span class="text-sm text-ink-muted">Συμμετέχοντες</span>
              <span class="text-sm font-semibold text-ink-strong">{booking.participantCount}</span>
            </div>
            <div class="flex justify-between gap-4 pt-3 border-t border-hairline">
              <span class="text-sm text-ink-muted">Σύνολο</span>
              <span class="font-display font-bold text-crimson text-2xl">€{booking.totalEur}</span>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <Button href={`#pay-${booking.id}`} variant="primary" size="lg">Πληρώστε τώρα</Button>
            <Button href={`tel:${phone.tel}`} variant="secondary">Καλέστε μας</Button>
          </div>
          <p class="mt-3 text-xs text-ink-muted">Σύνδεση με Viva Wallet — έρχεται σύντομα.</p>
        </>
      ) : (
        <>
          <p class="mt-4 text-ink-muted text-lg leading-relaxed">
            Ευχαριστούμε για το αίτημά σας. Αν χρειάζεστε άμεση απάντηση, καλέστε μας απευθείας.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <Button href="/" variant="primary">Επιστροφή στην αρχική</Button>
            <Button href={`tel:${phone.tel}`} variant="secondary">Καλέστε μας</Button>
          </div>
        </>
      )}
    </div>
  </Section>
</PageLayout>
