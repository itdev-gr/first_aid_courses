---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import { phone } from '../../lib/nav';

const url = new URL(Astro.request.url);
const id = url.searchParams.get('id');
---
<PageLayout title="Η πληρωμή δεν ολοκληρώθηκε" description="Η πληρωμή ακυρώθηκε ή απέτυχε. Μπορείτε να ξαναδοκιμάσετε." noindex>
  <Section tone="default" pad="lg">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mx-auto h-16 w-16 rounded-full bg-red-50 border border-red-200 flex items-center justify-center text-red-700">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </div>
      <h1 class="mt-6 font-display font-bold text-crimson text-3xl md:text-4xl">Η πληρωμή δεν ολοκληρώθηκε</h1>
      <p class="mt-4 text-ink-muted text-lg leading-relaxed">
        Η πληρωμή ακυρώθηκε ή απέτυχε. Δεν χρεωθήκατε. Μπορείτε να ξαναδοκιμάσετε ή να επικοινωνήσετε μαζί μας.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {id && <Button href={`/kratisi/success/?id=${id}`} variant="primary">Δοκιμάστε ξανά</Button>}
        <Button href={`tel:${phone.tel}`} variant="secondary">Καλέστε μας</Button>
      </div>
    </div>
  </Section>
</PageLayout>
