# Firebase — public (bundled into client JS, safe to expose)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase — server only (admin SDK service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Viva Wallet payments
# VIVA_MODE: mock (default) | demo | production
VIVA_MODE=mock
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
VIVA_WEBHOOK_KEY=
